# Production environment variables for TetraCore Hub Frontend
# These are used during build time

# Disable source maps in production for security
GENERATE_SOURCEMAP=false

# API URL - leave empty to use same domain as frontend
# If set, it will override the automatic detection
# REACT_APP_API_URL=https://hub.tetra-core.website

# Build environment
REACT_APP_ENV=production

# Enable production optimizations
NODE_ENV=production

# Public URL for assets
# Leave empty to use relative paths
PUBLIC_URL=

# Disable ESLint warnings during build
DISABLE_ESLINT_PLUGIN=true

# Increase memory for build process
NODE_OPTIONS=--max_old_space_size=4096
