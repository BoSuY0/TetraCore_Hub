    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "List Webhooks",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/webhooks"
          }
        },
        {
          "name": "Create Webhook",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/webhooks",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Task Completion\",\n  \"url\": \"https://example.com/webhook\",\n  \"events\": [\"task.completed\", \"task.failed\"],\n  \"secret\": \"webhook-secret\"\n}"
            }
