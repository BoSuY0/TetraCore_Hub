{
  "info": {
    "name": "TetraCore Hub API",
    "description": "TetraCore Hub - Distributed Task Orchestration System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-refresh token if expired",
          "const tokenExpiry = pm.environment.get('token_expiry');",
          "if (tokenExpiry && new Date(tokenExpiry) < new Date()) {",
          "    pm.sendRequest({",
          "        url: pm.environment.get('base_url') + '/auth/refresh',",
          "        method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: {",
          "            mode: 'raw',",
          "            raw: JSON.stringify({ refresh_token: pm.environment.get('refresh_token') })",
          "        }",
          "    }, function(err, res) {",
          "        if (!err && res.code === 200) {",
          "            const json = res.json();",
          "            pm.environment.set('jwt_token', json.token);",
          "            pm.environment.set('token_expiry', json.expires_at);",
          "        }",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Ready Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/ready",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Live Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/live",
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/stats",
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('jwt_token', json.token);",
                  "    pm.environment.set('refresh_token', json.refresh_token);",
                  "    pm.environment.set('token_expiry', json.expires_at);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/refresh",
            "auth": { "type": "noauth" },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/tasks?limit=50&offset=0",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tasks"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" },
                { "key": "status", "value": "", "disabled": true },
                { "key": "priority", "value": "", "disabled": true },
                { "key": "tags", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/tasks",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task_type\": \"data_processing\",\n  \"payload\": {\n    \"file\": \"data.csv\",\n    \"action\": \"process\"\n  },\n  \"priority\": \"normal\",\n  \"timeout\": 300,\n  \"tags\": [\"batch\", \"import\"]\n}"
            }
          }
        },
        {
          "name": "Get Task",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/tasks/{{task_id}}"
          }
        },
        {
          "name": "Cancel Task",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/tasks/{{task_id}}"
          }
        },
        {
          "name": "Get Task Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/tasks/stats"
          }
        }
      ]
    },
    {
      "name": "Clients",
      "item": [
        {
          "name": "List Clients",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/clients"
          }
        },
        {
          "name": "Get Client",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/clients/{{client_id}}"
          }
        },
        {
          "name": "Disconnect Client",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/clients/{{client_id}}/disconnect"
          }
        },
        {
          "name": "Get Client Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/clients/stats"
          }
        }
      ]
    },
    {
      "name": "Templates",
      "item": [
        {
          "name": "List Templates",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/templates"
          }
        },
        {
          "name": "Create Template",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/templates",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Data Import\",\n  \"description\": \"Import data from CSV file\",\n  \"task_type\": \"data_processing\",\n  \"executor_type\": \"worker\",\n  \"default_payload\": {\n    \"action\": \"import\"\n  },\n  \"default_tags\": [\"import\"],\n  \"default_priority\": \"normal\",\n  \"default_timeout\": 600,\n  \"variables\": [\n    {\n      \"name\": \"file_path\",\n      \"type\": \"string\",\n      \"required\": true,\n      \"description\": \"Path to CSV file\"\n    }\n  ],\n  \"is_public\": true\n}"
            }
          }
        },
        {
          "name": "Get Template",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/templates/{{template_id}}"
          }
        },
        {
          "name": "Execute Template",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/templates/{{template_id}}/execute",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variables\": {\n    \"file_path\": \"/data/import.csv\"\n  }\n}"
            }
          }
        },
        {
          "name": "Delete Template",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/templates/{{template_id}}"
          }
        }
      ]
    },
    {
      "name": "Dead Letter Queue",
      "item": [
        {
          "name": "List DLQ Entries",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/dlq"
          }
        },
        {
          "name": "Get DLQ Entry",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/dlq/{{dlq_id}}"
          }
        },
        {
          "name": "Retry DLQ Entry",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/dlq/{{dlq_id}}/retry"
          }
        },
        {
          "name": "Delete DLQ Entry",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/v1/dlq/{{dlq_id}}"
          }
        },
        {
          "name": "Get DLQ Stats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/dlq/stats"
          }
        },
        {
          "name": "Retry All DLQ",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/dlq/retry-all"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
