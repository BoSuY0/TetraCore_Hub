# TetraCore Hub Environment Configuration
# Copy this file to .env and fill in your values

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Authentication
REQUIRE_AUTHENTICATION=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
# ADMIN_PASSWORD_HASH=  # Optional: bcrypt hash of password
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_ISSUER=tetracore-hub

# Redis Configuration
# Supports multiple Redis URL environment variables for different hosting providers
REDIS_URL=redis://localhost:6379
# REDIS_TLS_URL=rediss://...  # For TLS connections
# UPSTASH_REDIS_URL=...  # For Upstash
# REDISCLOUD_URL=...  # For Redis Cloud
REDIS_TLS_ENABLED=false

# Redis Sentinel (optional)
# REDIS_SENTINEL_URLS=sentinel1:26379,sentinel2:26379,sentinel3:26379

# Redis Cluster (optional)
# REDIS_CLUSTER_NODES=node1:6379,node2:6379,node3:6379

# Security
ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=https://hub.tetra-core.website,https://your-domain.com

# Token Rotation (optional)
# AUTH_TOKEN=your_auth_token
# AUTH_TOKEN_ACTIVE=your_active_token
# AUTH_TOKEN_NEXT=your_next_token
# ENABLE_TOKEN_ROTATION=false

# Logging
LOG_LEVEL=info
# LOG_LEVEL=debug  # For development
