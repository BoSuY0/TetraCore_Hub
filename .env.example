# TetraCore StreamHub Environment Variables
# Copy this file to .env and fill in your values

# Authentication
ADMIN_USERNAME=
ADMIN_PASSWORD=  # Use bcrypt hash in production! Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt(12)).decode())"

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=
JWT_REFRESH_SECRET=

# Redis Configuration
REDIS_URL=redis://localhost:6379/0  # For production use Redis Cloud/Upstash URL

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# Environment
ENVIRONMENT=development  # development | production | testing

# Optional: API Keys (if needed)
# BOT_TOKEN_PROD=
# BOT_TOKEN_DEV=
# API_ID=
# API_HASH=

# Optional: AWS (if using AWS Secrets Manager)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Optional: Monitoring
# SENTRY_DSN=
# DATADOG_API_KEY=