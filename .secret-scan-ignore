# Known false positives of tools/secret_scan.py (run by .github/workflows/security.yml).
# Keep each rule narrow: a rule hides every finding it matches.

# Character sets for generating random secrets in internal/secrets/rotator.go
context: ^Chars:\s+"abcdefghijklmnopqrstuvwxyz
# Shell variable filled from the login response in scripts/test_hub.sh
context: ^TOKEN=(""|\$\(echo "\$LOGIN_RESP")
# Reports written by earlier steps of the security workflow
path: (^|/)(results\.sarif|sbom\.json)$
